<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="LPP Flowgorithm Kel. 5"/>
        <attribute name="authors" value="SHAFA"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 11:48:47 PM"/>
        <attribute name="created" value="U0hBRkE7REVTS1RPUC1ST1REMjQ2OzIwMjYtMDktMTY7MTA6NDk6MDQgUE07MjY5NQ=="/>
        <attribute name="edited" value="U0hBRkE7REVTS1RPUC1ST1REMjQ2OzIwMjYtMDktMTY7MTE6NDg6NDcgUE07MTsyODEw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jumlahPengunjung" type="Integer" array="False" size=""/>
            <declare name="usia" type="Integer" array="False" size=""/>
            <declare name="hargaTiket" type="Integer" array="False" size=""/>
            <declare name="totalHarga" type="Integer" array="False" size=""/>
            <declare name="diskon" type="Real" array="False" size=""/>
            <declare name="hargaAkhir" type="Real" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan jumlah pengunjung: &quot;" newline="True"/>
            <input variable="jumlahPengunjung"/>
            <assign variable="totalHarga" expression="0"/>
            <for variable="i" start="1" end="jumlahPengunjung" direction="inc" step="1">
                <output expression="&quot;Masukkan usia pengunjung:&quot;" newline="True"/>
                <input variable="usia"/>
                <if expression="usia &lt; 5">
                    <then>
                        <assign variable="hargaTiket" expression="0"/>
                    </then>
                    <else>
                        <if expression="usia &lt;= 12">
                            <then>
                                <assign variable="hargaTiket" expression="5"/>
                            </then>
                            <else>
                                <if expression="usia &lt;= 59">
                                    <then>
                                        <assign variable="hargaTiket" expression="10"/>
                                    </then>
                                    <else>
                                        <assign variable="hargaTiket" expression="7"/>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <assign variable="totalHarga" expression="totalHarga + hargaTiket"/>
            </for>
            <if expression="jumlahPengunjung &gt;= 5">
                <then>
                    <assign variable="diskon" expression="totalHarga * 0.10"/>
                </then>
                <else>
                    <assign variable="diskon" expression="0"/>
                </else>
            </if>
            <assign variable="hargaAkhir" expression="totalHarga - diskon"/>
            <output expression="&quot;Jumlah tiket: &quot; &amp; ToString(jumlahPengunjung)" newline="True"/>
            <output expression="&quot;Total harga sebelum diskon: $&quot; &amp; ToString(totalHarga)" newline="True"/>
            <output expression="&quot;Diskon: $&quot; &amp; ToString(diskon)" newline="True"/>
            <output expression="&quot;Harga akhir: $&quot; &amp; ToString(hargaAkhir)" newline="True"/>
        </body>
    </function>
</flowgorithm>
